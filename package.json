{
  "name": "agentdock",
  "private": true,
  "version": "0.2.2",
  "description": "A Liquid Glass voice speed-dial for your personal AI agents",
  "license": "MIT",
  "author": "we1jia",
  "homepage": "https://github.com/we1jia/AgentDock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we1jia/AgentDock.git"
  },
  "bugs": {
    "url": "https://github.com/we1jia/AgentDock/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/generate-icons.mjs",
    "signing": "bash scripts/setup-signing.sh",
    "build:mac": "APPLE_SIGNING_IDENTITY='AgentDock Local Signing' tauri build --bundles app,dmg",
    "test": "cd src-tauri && cargo test && cd .. && npm run build && python3 tests/e2e_mock.py",
    "test:xvfb": "bash tests/e2e_xvfb.sh",
    "shots": "python3 .shots/shoot.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
